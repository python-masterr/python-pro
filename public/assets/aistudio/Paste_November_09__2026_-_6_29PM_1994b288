      }

      // Grand Placement Victory Fanfare
      function playVictoryFanfare() {
        if (!sfxEnabled || audioState.volumePercent === 0) return;
        const ctx = getAudioContext();
        if (!ctx) return;

        const now = ctx.currentTime;
        const master = createCelestialMaster(ctx, 1.7, 1.0);
        const pitch = audioState.pitchMultiplier;

        const chordProg = [440, 554.37, 659.25, 880, 1108.7];
        chordProg.forEach((f, i) => {
          const freq = f * pitch;
          const osc = ctx.createOscillator();
          const g = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + i * 0.08);

          g.gain.setValueAtTime(0.0001, now + i * 0.08);
          g.gain.exponentialRampToValueAtTime(0.18 / (i + 1), now + i * 0.08 + 0.04);
          g.gain.exponentialRampToValueAtTime(0.0001, now + i * 0.08 + 1.25);

          osc.connect(g);
          g.connect(master);
          osc.start(now + i * 0.08);
          osc.stop(now + i * 0.08 + 1.35);
        });

        // Warm celestial starlight bell
        [1500, 1900].forEach((f, j) => {
          const bell = ctx.createOscillator();
          const bg = ctx.createGain();
          bell.type = 'sine';
          bell.frequency.setValueAtTime(f * pitch, now + 0.32 + j * 0.09);

          bg.gain.setValueAtTime(0.0001, now + 0.32 + j * 0.09);
          bg.gain.exponentialRampToValueAtTime(0.06, now + 0.35 + j * 0.09);
          bg.gain.exponentialRampToValueAtTime(0.0001, now + 0.32 + j * 0.09 + 0.8);

          bell.connect(bg);
          bg.connect(master);
          bell.start(now + 0.32 + j * 0.09);
          bell.stop(now + 0.32 + j * 0.09 + 0.85);
        });

        // Soft sub-bass body
        const subOsc = ctx.createOscillator();
        const subGain = ctx.createGain();
        subOsc.type = 'sine';
        subOsc.frequency.setValueAtTime(65 * pitch, now + 0.3);
        subOsc.frequency.exponentialRampToValueAtTime(42 * pitch, now + 1.0);

        subGain.gain.setValueAtTime(0.0001, now + 0.3);
        subGain.gain.exponentialRampToValueAtTime(0.2, now + 0.34);
        subGain.gain.exponentialRampToValueAtTime(0.0001, now + 1.05);

        subOsc.connect(subGain);
        subGain.connect(master);
        subOsc.start(now + 0.3);
        subOsc.stop(now + 1.1);

        triggerWaveBarsAnimation(1800);
      }

