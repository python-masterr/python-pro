        if (compTimeNote) compTimeNote.innerText = data.timeNote;
        if (compSpace) compSpace.innerText = data.spaceComp;
        if (compSpaceNote) compSpaceNote.innerText = data.spaceNote;
        if (trapText) trapText.innerHTML = data.trap;
        if (compTags) compTags.innerText = data.companies;

        // Dismiss celebration if visible
        const celebr = document.getElementById('submission-celebration-card');
        if (celebr) celebr.classList.add('hidden');
      }

      // Problem card click listeners
      document.querySelectorAll('.program-card').forEach(card => {
        card.addEventListener('click', function(e) {
          const pid = this.getAttribute('data-id');
          if (pid) selectProblem(pid);
        });
      });

      // RUN CODE SIMULATION WITH COMPILATION SWEEP & TICKER
      const runBtn = document.getElementById('run-code-btn');
      const runIcon = document.getElementById('run-code-icon');
      const runLabel = document.getElementById('run-code-label');
      const stdout = document.getElementById('stdout-output');
      const progressBar = document.getElementById('compilation-bar-container');
      const exitPill = document.getElementById('console-exit-pill');
      const exitText = document.getElementById('console-exit-text');
      const timeStat = document.getElementById('console-time-stat');
      const sandboxText = document.getElementById('sandbox-status-text');
      const sandboxDot = document.getElementById('sandbox-indicator-dot');

      if (runBtn && stdout) {
        runBtn.addEventListener('click', function() {
          if (isExecuting) return;
          isExecuting = true;

          // Visual loading state on button
          runIcon.className = 'w-4 h-4 border-2 border-primary border-t-transparent rounded-full animate-spin';
          runLabel.innerText = 'Executing in Orbit...';
          runBtn.classList.add('ring-2', 'ring-primary', 'shadow-[0_0_20px_#06b6d4]');

          // Show compilation sweep bar
          if (progressBar) progressBar.classList.remove('opacity-0');
          if (sandboxText) sandboxText.innerText = 'Compiling AST Bytecode...';
          if (sandboxDot) sandboxDot.className = 'w-2 h-2 rounded-full bg-python-yellow animate-ping shadow-[0_0_8px_#ffd43b]';

          if (exitPill) exitPill.className = 'text-python-yellow flex items-center gap-1';
          if (exitText) exitText.innerText = 'Running...';

          // Step 1: Connecting sequence
          stdout.innerHTML = `
            <div class="text-terminal-cyan flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-terminal-cyan animate-pulse"></span>
              Connecting to orbital sandbox v3.12 celestial container...
            </div>
          `;

          // Step 2: Compiling sequence
          setTimeout(() => {
            stdout.innerHTML += `
              <div class="text-on-surface-variant flex items-center gap-2">
                <span class="material-symbols-outlined text-xs text-primary">terminal</span>
                Optimizing AST bytecode representation & symbol tables...
              </div>
            `;
          }, 320);

          // Step 3: Running test suites
          setTimeout(() => {
            stdout.innerHTML += `
              <div class="text-on-surface-variant flex items-center gap-2">
                <span class="material-symbols-outlined text-xs text-cosmic-magenta">verified</span>
                Executing test assertions against Python 3.12 runtime...
              </div>
            `;
          }, 650);

          // Step 4: Finished result reveal with counter ticker
          setTimeout(() => {
            const data = problemData[activeProblemId] || problemData['p-03'];
            const runtimeMs = (Math.random() * 0.02 + 0.012).toFixed(3);

            stdout.innerHTML = `
              <div class="text-success-emerald font-semibold flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm">check_circle</span>
                ${data.output}
              </div>
              <div class="text-outline text-xs mt-1 pt-1 border-t border-white/5 flex items-center gap-3">
                <span>Process returned exit code 0</span>
                <span>•</span>
                <span class="text-terminal-cyan">CPU Time: ${runtimeMs}s</span>
                <span>•</span>
                <span class="text-success-emerald">Memory: 14.2 MB</span>
              </div>
            `;

            // Restore elements
            runIcon.className = 'material-symbols-outlined text-sm text-terminal-cyan';
            runLabel.innerText = 'Run Code';
            runBtn.classList.remove('ring-2', 'ring-primary', 'shadow-[0_0_20px_#06b6d4]');
            if (progressBar) progressBar.classList.add('opacity-0');

            if (exitPill) exitPill.className = 'text-success-emerald flex items-center gap-1';
            if (exitText) exitText.innerText = 'Exit Code: 0';
            if (timeStat) timeStat.innerText = `${runtimeMs}s · Orbital Runtime`;
            if (sandboxText) sandboxText.innerText = 'Safe Execution';
            if (sandboxDot) sandboxDot.className = 'w-2 h-2 rounded-full bg-pulsar-cyan shadow-[0_0_6px_#06b6d4]';

            isExecuting = false;
          }, 1100);
        });
      }

      // SUBMIT SOLUTION WITH CELEBRATION PARTICLES & BANNER
      const submitBtn = document.getElementById('submit-solution-btn');
      const submitIcon = document.getElementById('submit-btn-icon');
      const submitLabel = document.getElementById('submit-btn-label');
      const celebrationCard = document.getElementById('submission-celebration-card');
      const dismissBtn = document.getElementById('dismiss-celebration-btn');
      const nextBtn = document.getElementById('next-problem-btn');

      function triggerCelebrationSparks(originElement) {
        const rect = originElement.getBoundingClientRect();
        const colors = ['#fbbf24', '#f59e0b', '#10b981', '#34d399', '#fef08a'];
        const count = 28;

        for (let i = 0; i < count; i++) {
          const spark = document.createElement('div');
          spark.className = 'starlight-spark';
          const color = colors[Math.floor(Math.random() * colors.length)];
          spark.style.backgroundColor = color;
          spark.style.boxShadow = `0 0 8px ${color}`;

          const startX = rect.left + rect.width / 2;
          const startY = rect.top + rect.height / 2;
          spark.style.left = `${startX}px`;
          spark.style.top = `${startY}px`;

          const angle = Math.random() * Math.PI * 2;
          const velocity = 50 + Math.random() * 120;
          const tx = Math.cos(angle) * velocity;
          const ty = Math.sin(angle) * velocity - 20;

          spark.style.setProperty('--tx', `${tx}px`);
          spark.style.setProperty('--ty', `${ty}px`);
          document.body.appendChild(spark);

          setTimeout(() => spark.remove(), 900);
        }
      }

      if (submitBtn) {
        submitBtn.addEventListener('click', function() {
          submitIcon.className = 'w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin';
          submitLabel.innerText = 'Verifying Solution...';

          setTimeout(() => {
            submitIcon.className = 'material-symbols-outlined text-sm text-success-emerald';
            submitIcon.innerText = 'check_circle';
            submitLabel.innerText = 'Passed All Suites!';

            triggerCelebrationSparks(submitBtn);

            if (celebrationCard) {
              celebrationCard.classList.remove('hidden');
              celebrationCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            // Update stats pill increment effect
            const statCompleted = document.getElementById('stat-completed-count');
            if (statCompleted && !statCompleted.innerText.includes('3')) {
              statCompleted.innerText = '3 / 18';
              statCompleted.classList.add('animate-pulse');
              setTimeout(() => statCompleted.classList.remove('animate-pulse'), 1500);
            }

            setTimeout(() => {
              submitIcon.className = 'material-symbols-outlined text-sm';
              submitIcon.innerText = 'cloud_upload';
              submitLabel.innerText = 'Submit Solution';
            }, 2500);
          }, 700);
        });
      }

      if (dismissBtn && celebrationCard) {
        dismissBtn.addEventListener('click', () => {
          celebrationCard.classList.add('hidden');
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          const ids = ['p-01', 'p-02', 'p-03', 'p-04', 'p-05', 'p-06'];
          const currentIndex = ids.indexOf(activeProblemId);
          const nextIndex = (currentIndex + 1) % ids.length;
          selectProblem(ids[nextIndex]);
        });
      }

      // COPY CODE SNIPPET FEEDBACK
      const copyBtn = document.getElementById('copy-code-btn');
      const copyIcon = document.getElementById('copy-btn-icon');
      const copyText = document.getElementById('copy-btn-text');

      if (copyBtn) {
        copyBtn.addEventListener('click', function() {
          copyIcon.innerText = 'done_all';
          copyIcon.className = 'material-symbols-outlined text-sm text-success-emerald';
          copyText.innerText = 'Copied to clipboard!';
          copyBtn.classList.add('border-success-emerald/50', 'text-success-emerald');

          setTimeout(() => {
            copyIcon.innerText = 'content_copy';
            copyIcon.className = 'material-symbols-outlined text-sm';
            copyText.innerText = 'Copy Code';
            copyBtn.classList.remove('border-success-emerald/50', 'text-success-emerald');
          }, 1800);
        });
      }

      // RESET CODE BUTTON
      const resetBtn = document.getElementById('reset-code-btn');
      const resetText = document.getElementById('reset-btn-text');

      if (resetBtn && stdout) {
        resetBtn.addEventListener('click', function() {
          resetText.innerText = 'Resetting...';
          setTimeout(() => {
            resetText.innerText = 'Reset';
            selectProblem(activeProblemId);
            stdout.innerHTML = '<span class="text-outline text-xs">Code restored to default scaffold solution.</span>';
          }, 300);
        });
      }

      // DIFFICULTY FILTER PILLS
      document.querySelectorAll('#difficulty-filters .filter-pill').forEach(pill => {
        pill.addEventListener('click', function() {
          document.querySelectorAll('#difficulty-filters .filter-pill').forEach(p => {
            p.classList.remove('active', 'border-primary/40', 'shadow-sm', 'shadow-primary/20', 'bg-surface-container-highest/90', 'text-primary');
          });
          this.classList.add('active', 'border-primary/40', 'shadow-sm', 'shadow-primary/20', 'bg-surface-container-highest/90', 'text-primary');

          const filter = this.getAttribute('data-filter');
          document.querySelectorAll('.program-card').forEach(card => {
            const cardBadge = card.innerText.toLowerCase();
            if (filter === 'all') {
              card.style.display = 'block';
            } else if (cardBadge.includes(filter)) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // Quick Search Filter Input
      const searchInput = document.getElementById('program-search');
      if (searchInput) {
        searchInput.addEventListener('input', function(e) {
          const query = e.target.value.toLowerCase().trim();
          document.querySelectorAll('.program-card').forEach(card => {
            const text = card.innerText.toLowerCase();
            card.style.display = text.includes(query) ? 'block' : 'none';
          });
        });
      }

      // ==========================================
      // INTERACTIVE GALAXY DOTS & CURSOR EFFECT
      // ==========================================
      const canvas = document.getElementById('galaxy-dots-canvas');
      const aura = document.getElementById('cosmic-cursor-aura');
      const core = document.getElementById('cosmic-cursor-core');

      if (canvas && canvas.getContext) {
        const ctx = canvas.getContext('2d');
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        });

        // Mouse & pointer telemetry with smooth lerp
        const mouse = {
          x: width / 2,
          y: height / 2,
          targetX: width / 2,
          targetY: height / 2,
          active: false,
          lastTrailX: 0,
          lastTrailY: 0
        };

        const celestialDotsColors = [
          '#06b6d4', // pulsar-cyan
          '#38bdf8', // terminal-cyan
          '#8b5cf6', // cosmic-violet
          '#fbbf24', // radiant gold
          '#10b981'  // vibrant emerald
        ];

        const particlePalette = [
          '#fbbf24', // radiant gold
          '#f59e0b', // rich amber gold
          '#fef08a', // starlight light gold
          '#d97706', // deep gold
          '#10b981', // vibrant emerald
          '#34d399', // luminous mint emerald
          '#6ee7b7', // soft emerald
          '#059669'  // deep emerald
        ];

        // 170+ Twinkling Galaxy Dots
        const STAR_COUNT = 180;
        const stars = [];

        for (let i = 0; i < STAR_COUNT; i++) {
          stars.push({
            x: Math.random() * width,
            y: Math.random() * height,
            originX: Math.random() * width,
            originY: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.45,
            vy: (Math.random() - 0.5) * 0.45,
            radius: Math.random() * 1.8 + 0.6,
            color: celestialDotsColors[Math.floor(Math.random() * celestialDotsColors.length)],
            twinkleSpeed: 0.015 + Math.random() * 0.035,
            twinkleAngle: Math.random() * Math.PI * 2,
            baseAlpha: 0.25 + Math.random() * 0.55
          });
        }

        // Mouse movement tracking
        window.addEventListener('mousemove', (e) => {
          mouse.targetX = e.clientX;
          mouse.targetY = e.clientY;
          if (!mouse.active) {
            mouse.active = true;
            if (aura) aura.style.opacity = '1';
            if (core) core.style.opacity = '1';
          }

          // Spawn subtle stardust trail on rapid cursor shift with gold & emerald palette
          const dist = Math.hypot(e.clientX - mouse.lastTrailX, e.clientY - mouse.lastTrailY);
          if (dist > 18) {
            mouse.lastTrailX = e.clientX;
            mouse.lastTrailY = e.clientY;
            createStardustMote(e.clientX, e.clientY);
          }
        });

        window.addEventListener('mouseleave', () => {
          mouse.active = false;
          if (aura) aura.style.opacity = '0';
          if (core) core.style.opacity = '0';
        });

        // Stardust trail mote generator in vibrant gold & emerald
        function createStardustMote(x, y) {
          const mote = document.createElement('div');
          mote.className = 'cursor-stardust';
          const size = Math.random() * 4 + 2;
          const col = particlePalette[Math.floor(Math.random() * particlePalette.length)];
          mote.style.width = `${size}px`;
          mote.style.height = `${size}px`;
          mote.style.backgroundColor = col;
          mote.style.boxShadow = `0 0 10px ${col}, 0 0 16px ${col}`;
          mote.style.left = `${x}px`;
          mote.style.top = `${y}px`;

          const offsetX = (Math.random() - 0.5) * 26;
          const offsetY = (Math.random() - 0.5) * 26;
          document.body.appendChild(mote);

          requestAnimationFrame(() => {
            mote.style.transform = `translate(${offsetX}px, ${offsetY + 12}px) scale(0)`;
            mote.style.opacity = '0';
          });

          setTimeout(() => {
            if (mote.parentNode) mote.parentNode.removeChild(mote);
          }, 650);
        }

        // Animation Loop with Constellation Web Lines & Gravity repulsion
        function animate() {
          ctx.clearRect(0, 0, width, height);

          // Interpolate cursor coords
          mouse.x += (mouse.targetX - mouse.x) * 0.15;
          mouse.y += (mouse.targetY - mouse.y) * 0.15;

          if (aura) {
            aura.style.left = `${mouse.x}px`;
            aura.style.top = `${mouse.y}px`;
          }
          if (core) {
            core.style.left = `${mouse.targetX}px`;
            core.style.top = `${mouse.targetY}px`;
          }

          // Update & draw galaxy stars
          for (let i = 0; i < stars.length; i++) {
            const star = stars[i];

            // Drift movement
            star.x += star.vx;
            star.y += star.vy;

            // Cosmic edge looping
            if (star.x < 0) star.x = width;
            else if (star.x > width) star.x = 0;
            if (star.y < 0) star.y = height;
            else if (star.y > height) star.y = 0;

            // Interactive cursor repulsion/wake
            if (mouse.active) {
              const dx = star.x - mouse.x;
              const dy = star.y - mouse.y;
              const dist = Math.hypot(dx, dy);
              const maxDist = 135;

              if (dist < maxDist && dist > 0.1) {
                const force = (1 - dist / maxDist) * 3.8;
                star.x += (dx / dist) * force;
                star.y += (dy / dist) * force;
              }
            }

            // Twinkle oscillation
            star.twinkleAngle += star.twinkleSpeed;
            const currentAlpha = Math.max(0.1, Math.min(1, star.baseAlpha + Math.sin(star.twinkleAngle) * 0.35));

            // Render star dot
            ctx.save();
            ctx.beginPath();
            ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
            ctx.fillStyle = star.color;
            ctx.globalAlpha = currentAlpha;
            ctx.shadowColor = star.color;
            ctx.shadowBlur = star.radius > 1.4 ? 6 : 2;
            ctx.fill();
            ctx.restore();

            // Connect nearby stars with delicate constellation web lines
            for (let j = i + 1; j < stars.length; j++) {
              const star2 = stars[j];
              const distStars = Math.hypot(star.x - star2.x, star.y - star2.y);
              const connectDistance = 72;

              if (distStars < connectDistance) {
                const lineAlpha = (1 - distStars / connectDistance) * 0.16;
                ctx.save();
                ctx.beginPath();
                ctx.moveTo(star.x, star.y);
                ctx.lineTo(star2.x, star2.y);
                ctx.strokeStyle = '#38bdf8';
                ctx.globalAlpha = lineAlpha;
                ctx.lineWidth = 0.65;
                ctx.stroke();
                ctx.restore();
              }
            }
          }

          requestAnimationFrame(animate);
        }

        animate();
      }

    })();
  </script>
