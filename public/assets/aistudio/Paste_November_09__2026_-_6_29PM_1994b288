      // Run Code Compilation chirps
      function playRunCodeSequence() {
        if (!sfxEnabled || audioState.volumePercent === 0) return;
        const ctx = getAudioContext();
        if (!ctx) return;

        const now = ctx.currentTime;
        const master = createCelestialMaster(ctx, 0.85, 0.85);
        const pitch = audioState.pitchMultiplier;

        const blipFreqs = [700, 1050, 1400];
        blipFreqs.forEach((f, i) => {
          const freq = f * pitch;
          const osc = ctx.createOscillator();
          const g = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now + i * 0.05);
          osc.frequency.exponentialRampToValueAtTime(freq * 1.15, now + i * 0.05 + 0.035);

          g.gain.setValueAtTime(0.0001, now + i * 0.05);
          g.gain.exponentialRampToValueAtTime(0.12, now + i * 0.05 + 0.01);
          g.gain.exponentialRampToValueAtTime(0.0001, now + i * 0.05 + 0.04);

          osc.connect(g);
          g.connect(master);
          osc.start(now + i * 0.05);
          osc.stop(now + i * 0.05 + 0.045);
        });

        const humOsc = ctx.createOscillator();
        const humFilter = ctx.createBiquadFilter();
        const humGain = ctx.createGain();

        humOsc.type = 'triangle';
        humOsc.frequency.setValueAtTime(180 * pitch, now + 0.14);
        humOsc.frequency.exponentialRampToValueAtTime(360 * pitch, now + 0.65);

        humFilter.type = 'lowpass';
        humFilter.frequency.setValueAtTime(400 * pitch, now + 0.14);
        humFilter.frequency.exponentialRampToValueAtTime(1400 * pitch, now + 0.65);

        humGain.gain.setValueAtTime(0.0001, now + 0.14);
        humGain.gain.linearRampToValueAtTime(0.08, now + 0.3);
        humGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.72);

        humOsc.connect(humFilter);
        humFilter.connect(humGain);
        humGain.connect(master);

        humOsc.start(now + 0.14);
        humOsc.stop(now + 0.74);
      }

      // Execution Completed Success Chime
      function playRunCompletedChime() {
        if (!sfxEnabled || audioState.volumePercent === 0) return;
