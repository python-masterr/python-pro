      // SFX 1: Cosmic Cyan
      function playCosmicCyanSfx() {
        if (!sfxEnabled || audioState.volumePercent === 0) return;
        const ctx = getAudioContext();
        if (!ctx) return;

        const now = ctx.currentTime;
        const master = createCelestialMaster(ctx, 1.4, 0.95);
        const pitch = audioState.pitchMultiplier;

        const baseNotes = [528, 792, 1056];
        baseNotes.forEach((f, idx) => {
          const freq = f * pitch;
          const osc = ctx.createOscillator();
          const noteGain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now + idx * 0.07);
          osc.frequency.exponentialRampToValueAtTime(freq * 1.15, now + idx * 0.07 + 0.35);

          noteGain.gain.setValueAtTime(0.0001, now);
          noteGain.gain.exponentialRampToValueAtTime(0.2 / (idx + 1), now + idx * 0.07 + 0.03);
          noteGain.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.07 + 0.75);

          osc.connect(noteGain);
          noteGain.connect(master);
          osc.start(now + idx * 0.07);
          osc.stop(now + idx * 0.07 + 0.8);
        });

        // Soft shimmer sweep
        const sweepOsc = ctx.createOscillator();
        const sweepGain = ctx.createGain();
        sweepOsc.type = 'triangle';
        sweepOsc.frequency.setValueAtTime(1100 * pitch, now);
        sweepOsc.frequency.exponentialRampToValueAtTime(1900 * pitch, now + 0.32);

        sweepGain.gain.setValueAtTime(0.0001, now);
        sweepGain.gain.exponentialRampToValueAtTime(0.05, now + 0.05);
        sweepGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.45);

        sweepOsc.connect(sweepGain);
        sweepGain.connect(master);
        sweepOsc.start(now);
        sweepOsc.stop(now + 0.5);

        showSfxToast('Cosmic Nebula Warp', `Cyan Theme (${audioState.pitchPresetName})`, false);
      }

      // SFX 2: Gold & Emerald Alchemy
      function playGoldEmeraldSfx() {
