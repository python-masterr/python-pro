      const testAcousticBtn = document.getElementById('test-acoustic-sample-btn');

      // Mechanical Switch Controls & State
      const mechSwitchCyclerBtn = document.getElementById('mech-switch-cycler-btn');
      const mechSwitchLabel = document.getElementById('mech-switch-label');
      const headerTestKeycapBtn = document.getElementById('header-test-keycap-btn');
      const popoverMechStatus = document.getElementById('popover-mech-status');
      const popoverTestKeycapBtn = document.getElementById('popover-test-keycap-btn');
      const mechSelectBtns = document.querySelectorAll('.mech-select-btn');
      const editorWrapper = document.getElementById('editor-wrapper');
      const editorCodeBody = document.getElementById('editor-code-body');
      const cursorCaret = document.getElementById('cursor-caret');

      const switchOrder = ['blue', 'brown', 'red', 'off'];
      const switchMeta = {
        'blue': { name: 'Blue Clicky', desc: 'Crisp click + metallic ping', icon: 'keyboard' },
        'brown': { name: 'Brown Tactile', desc: 'Mellow balanced thock', icon: 'keyboard' },
        'red': { name: 'Red Linear', desc: 'Creamy deep bottom-out thock', icon: 'keyboard' },
        'off': { name: 'Mech: Muted', desc: 'Typing sound effects disabled', icon: 'keyboard_off' }
      };

      function updateMechSwitchUI(sw) {
        audioState.mechSwitch = sw;
        const meta = switchMeta[sw];

        if (mechSwitchLabel) {
          mechSwitchLabel.innerText = sw === 'off' ? 'Mech: Off' : `Mech: ${meta.name.split(' ')[0]}`;
        }
        if (popoverMechStatus) {
          popoverMechStatus.innerText = meta.name;
        }

        // Update active class on popover buttons
        mechSelectBtns.forEach(btn => {
          if (btn.dataset.switch === sw) {
            btn.className = 'mech-select-btn active py-1 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 text-center font-medium';
          } else {
            btn.className = 'mech-select-btn py-1 rounded-lg text-slate-400 hover:text-white bg-slate-800 text-center';
          }
        });
      }

      // Cycle mechanical switch profile
      function cycleMechSwitch() {
        const curIdx = switchOrder.indexOf(audioState.mechSwitch);
        const nextIdx = (curIdx + 1) % switchOrder.length;
        const nextSw = switchOrder[nextIdx];
        updateMechSwitchUI(nextSw);

        if (nextSw !== 'off') {
          playMechanicalKeypress('standard');
          showSfxToast(`Switch: ${switchMeta[nextSw].name}`, switchMeta[nextSw].desc, false, 'keyboard');
        } else {
          playTactileClick();
          showSfxToast('Mech SFX Muted', 'Keyboard audio typing muted', false, 'keyboard_off');
        }
      }

      if (mechSwitchCyclerBtn) {
        mechSwitchCyclerBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          cycleMechSwitch();
        });
      }

      // Popover mech switch selector buttons
      mechSelectBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const sw = btn.dataset.switch;
          updateMechSwitchUI(sw);
          if (sw !== 'off') {
            playMechanicalKeypress('standard');
            showSfxToast(`Switch: ${switchMeta[sw].name}`, switchMeta[sw].desc, false, 'keyboard');
          } else {
            playTactileClick();
            showSfxToast('Mech SFX Muted', 'Keyboard typing audio off', false, 'keyboard_off');
          }
        });
      });

      // Test Keycap buttons (header + popover)
      function triggerTestKeycap(btn) {
        if (btn) {
          btn.classList.add('pressed');
          setTimeout(() => btn.classList.remove('pressed'), 120);
        }
        playMechanicalKeypress('standard');
        const sw = audioState.mechSwitch;
        if (sw !== 'off') {
          showSfxToast(`${switchMeta[sw].name} Keystroke`, 'Downstroke click + bottom-out thock synthesized', false, 'keyboard');
        }
      }

      if (headerTestKeycapBtn) {
        headerTestKeycapBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          triggerTestKeycap(headerTestKeycapBtn);
        });
      }
      if (popoverTestKeycapBtn) {
        popoverTestKeycapBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          triggerTestKeycap(popoverTestKeycapBtn);
        });
      }

      // Real-time Keystroke Detection for Code Editor
      function handleEditorKeydown(e) {
        // Determine key acoustics (Spacebar has deeper thock, Enter has carriage clack, Backspace is soft)
        let keyType = 'standard';
        if (e.code === 'Space') keyType = 'space';
        else if (e.code === 'Enter') keyType = 'enter';
        else if (e.code === 'Backspace' || e.code === 'Delete') keyType = 'backspace';

        playMechanicalKeypress(keyType);

        // Micro-sparkle pulse on caret
        if (cursorCaret) {
          cursorCaret.style.transform = 'scale(1.25)';
          cursorCaret.style.backgroundColor = '#67e8f9';
          cursorCaret.style.boxShadow = '0 0 14px #38bdf8, 0 0 20px #d946ef';
          setTimeout(() => {
            cursorCaret.style.transform = 'scale(1)';
            cursorCaret.style.backgroundColor = '#22d3ee';
            cursorCaret.style.boxShadow = '0 0 8px #38bdf8';
          }, 80);
        }
      }

      if (editorCodeBody) {
        editorCodeBody.addEventListener('keydown', handleEditorKeydown);
      }
      if (editorWrapper) {
        // Also listen if wrapper has focus
        editorWrapper.addEventListener('keydown', (e) => {
          if (document.activeElement !== editorCodeBody) {
            handleEditorKeydown(e);
          }
        });
      }

      // Popover toggling
      let isPopoverOpen = false;
      function toggleAudioSettings(force) {
        isPopoverOpen = (force !== undefined) ? force : !isPopoverOpen;
        if (isPopoverOpen) {
          audioSettingsPopover.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
          audioSettingsPopover.classList.add('opacity-100', 'translate-y-0');
          audioSettingsToggleBtn.classList.add('text-cyan-400', 'bg-slate-800');
          audioSettingsIcon.classList.add('rotate-90');
          audioSettingsToggleBtn.setAttribute('aria-expanded', 'true');
        } else {
          audioSettingsPopover.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
          audioSettingsPopover.classList.remove('opacity-100', 'translate-y-0');
          audioSettingsToggleBtn.classList.remove('text-cyan-400', 'bg-slate-800');
          audioSettingsIcon.classList.remove('rotate-90');
          audioSettingsToggleBtn.setAttribute('aria-expanded', 'false');
        }
      }

      if (audioSettingsToggleBtn) {
        audioSettingsToggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleAudioSettings();
          playTactileClick();
        });
      }

      // Close popover when clicking outside
      document.addEventListener('click', (e) => {
        if (isPopoverOpen && !audioSettingsPopover.contains(e.target) && !audioSettingsToggleBtn.contains(e.target)) {
          toggleAudioSettings(false);
        }
      });

      // Volume slider real-time update
      if (volumeSlider) {
        volumeSlider.addEventListener('input', (e) => {
