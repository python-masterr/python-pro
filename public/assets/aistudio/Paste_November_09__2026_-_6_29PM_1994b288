<!-- Interactive JavaScript: Web Audio Synthesizer Engine & Mechanical Keyboard SFX Engine -->
<script>
    (function() {
      // ==========================================
      // TUNED WEB AUDIO SYNTHESIZER ENGINE WITH ACOUSTIC DSP
      // ==========================================
      let audioCtx = null;
      let sfxEnabled = true;

      // Acoustic state with tuned comfortable defaults
      const audioState = {
        volumePercent: 65,          // Default 65% for balanced, non-ear-piercing volume
        masterGainCap: 0.18,        // Safe peak max volume ceiling (prevents harsh distortion)
        pitchMultiplier: 1.0,       // 1.0 = Solfeggio 528Hz, 0.818 = 432Hz harmonic, 0.5 = Deep Nebula
        pitchPresetName: 'Cosmic Pure 528Hz',
        reverbBloom: true,          // Low-pass warmth filter active
        mechSwitch: 'blue'          // 'blue', 'brown', 'red', 'off'
      };

      function getAudioContext() {
        if (!audioCtx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) {
            audioCtx = new AudioContext();
          }
        }
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        return audioCtx;
      }

      // Safe master output channel with calibrated gain scaling and low-pass filter
      function createCelestialMaster(ctx, duration = 1.0, baseFactor = 1.0) {
        const userVolRatio = audioState.volumePercent / 100;
        const targetGain = audioState.masterGainCap * userVolRatio * baseFactor;

        const masterGain = ctx.createGain();
        const now = ctx.currentTime;
        masterGain.gain.setValueAtTime(Math.max(0.0001, targetGain), now);
        masterGain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

        if (audioState.reverbBloom) {
          const filter = ctx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(3800 * audioState.pitchMultiplier, now);
          filter.Q.setValueAtTime(0.7, now);

          masterGain.connect(filter);
          filter.connect(ctx.destination);
        } else {
          masterGain.connect(ctx.destination);
        }

        return masterGain;
      }

      // Procedural White Noise Buffer Generator for mechanical snaps
      let noiseBuffer = null;
      function getNoiseBuffer(ctx) {
        if (!noiseBuffer) {
          const bufferSize = ctx.sampleRate * 0.25; // 250ms buffer
          noiseBuffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
          const output = noiseBuffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            output[i] = Math.random() * 2 - 1;
          }
        }
        return noiseBuffer;
      }

      // ==========================================
      // PROCEDURAL MECHANICAL KEYBOARD SYNTHESIZER
      // ==========================================
      // Synthesizes authentic mechanical keypress acoustics:
      // 1. Transient sharp click (metallic contact leaf snap)
      // 2. Hollow case bottom-out (deep thock resonance ~140Hz-220Hz)
      // 3. Upstroke clack release
      function playMechanicalKeypress(keyType = 'standard') {
        if (!sfxEnabled || audioState.volumePercent === 0 || audioState.mechSwitch === 'off') return;
        const ctx = getAudioContext();
        if (!ctx) return;

        const now = ctx.currentTime;
        const userVolRatio = audioState.volumePercent / 100;
        // Jitter pitch slightly (+/- 4%) so every keystroke sounds organic and physical
        const jitter = 0.96 + Math.random() * 0.08;

        const master = ctx.createGain();
        const masterVol = 0.35 * userVolRatio;
        master.gain.setValueAtTime(masterVol, now);
        master.connect(ctx.destination);

        const sw = audioState.mechSwitch; // 'blue', 'brown', 'red'

        // 1. CLICK / TRANSIENT SNAP (High frequency metallic leaf contact)
        if (sw === 'blue' || sw === 'brown') {
          const clickGain = ctx.createGain();
          const clickFilter = ctx.createBiquadFilter();
          clickFilter.type = 'bandpass';

          // Blue is sharp & high; Brown is gentler bump
          const centerFreq = (sw === 'blue' ? 3200 : 2100) * jitter;
          clickFilter.frequency.setValueAtTime(centerFreq, now);
          clickFilter.Q.setValueAtTime(sw === 'blue' ? 3.5 : 1.8, now);

          const noise = ctx.createBufferSource();
          noise.buffer = getNoiseBuffer(ctx);

          const clickVol = (sw === 'blue' ? 0.32 : 0.16) * (keyType === 'space' ? 0.7 : 1.0);
          clickGain.gain.setValueAtTime(0.0001, now);
          clickGain.gain.linearRampToValueAtTime(clickVol, now + 0.002);
          clickGain.gain.exponentialRampToValueAtTime(0.0001, now + (sw === 'blue' ? 0.022 : 0.016));

          noise.connect(clickFilter);
          clickFilter.connect(clickGain);
          clickGain.connect(master);
          noise.start(now);
          noise.stop(now + 0.03);

          // Metallic Leaf Ping (Sine blip for Blue clicky)
          if (sw === 'blue') {
            const pingOsc = ctx.createOscillator();
            const pingGain = ctx.createGain();
            pingOsc.type = 'sine';
            pingOsc.frequency.setValueAtTime(2600 * jitter, now);
            pingOsc.frequency.exponentialRampToValueAtTime(1400 * jitter, now + 0.015);

            pingGain.gain.setValueAtTime(0.12, now);
            pingGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.018);

            pingOsc.connect(pingGain);
            pingGain.connect(master);
            pingOsc.start(now);
            pingOsc.stop(now + 0.02);
          }
        }

        // 2. BOTTOM-OUT THOCK (Acoustic cavity resonance)
        // Red is smooth creamy thock; Brown is warm balanced thock; Blue has deeper underlying thock
        const thockOsc = ctx.createOscillator();
        const thockGain = ctx.createGain();
        thockOsc.type = (sw === 'red') ? 'triangle' : 'sine';

        // Base frequency varies based on key: Spacebar is deeper, Enter is resonant
        let baseThockFreq = 185;
        let decayDuration = 0.045;
        if (keyType === 'space') {
          baseThockFreq = 120; // Deeper hollow bar
          decayDuration = 0.07;
        } else if (keyType === 'enter') {
          baseThockFreq = 160;
          decayDuration = 0.055;
        } else if (keyType === 'backspace') {
          baseThockFreq = 210;
          decayDuration = 0.035;
        }

        if (sw === 'red') baseThockFreq *= 0.88; // Creamier, lower pitch
        if (sw === 'brown') baseThockFreq *= 0.95;

        thockOsc.frequency.setValueAtTime(baseThockFreq * jitter, now + 0.004);
        thockOsc.frequency.exponentialRampToValueAtTime(baseThockFreq * 0.6 * jitter, now + decayDuration);

        const thockPeak = (sw === 'red' ? 0.38 : sw === 'brown' ? 0.32 : 0.24);
        thockGain.gain.setValueAtTime(0.0001, now + 0.004);
        thockGain.gain.linearRampToValueAtTime(thockPeak, now + 0.008);
        thockGain.gain.exponentialRampToValueAtTime(0.0001, now + decayDuration);

        thockOsc.connect(thockGain);
        thockGain.connect(master);
        thockOsc.start(now + 0.004);
        thockOsc.stop(now + decayDuration + 0.01);

        // 3. UPSTROKE RELEASE CLACK (Subtle, lighter release rattle)
        const releaseTime = now + (keyType === 'space' ? 0.065 : 0.045);
        const relGain = ctx.createGain();
        const relFilter = ctx.createBiquadFilter();
        relFilter.type = 'highpass';
        relFilter.frequency.setValueAtTime(1400 * jitter, releaseTime);

        const relNoise = ctx.createBufferSource();
        relNoise.buffer = getNoiseBuffer(ctx);

        relGain.gain.setValueAtTime(0.0001, releaseTime);
        relGain.gain.linearRampToValueAtTime(0.08, releaseTime + 0.003);
        relGain.gain.exponentialRampToValueAtTime(0.0001, releaseTime + 0.02);

        relNoise.connect(relFilter);
        relFilter.connect(relGain);
        relGain.connect(master);
        relNoise.start(releaseTime);
        relNoise.stop(releaseTime + 0.025);

        // Visual sparkle / keypress indicator
        triggerWaveBarsAnimation(150);
      }

      // Visual pulse wave bars when sound plays
      function triggerWaveBarsAnimation(duration = 1000) {
        const waveBars = document.querySelectorAll('#sfx-wave-bars .audio-bar, #toast-bars .audio-bar');
        waveBars.forEach(b => b.classList.add('playing'));
        setTimeout(() => {
          waveBars.forEach(b => b.classList.remove('playing'));
        }, duration);
      }

      let toastTimer = null;
      function showSfxToast(title, desc, isGold, customIcon) {
        const toast = document.getElementById('sfx-toast');
        const toastTitle = document.getElementById('toast-title');
        const toastDesc = document.getElementById('toast-desc');
        const iconWrap = document.getElementById('toast-icon-wrap');
        const toastIcon = document.getElementById('toast-icon');

        if (!toast) return;
        if (toastTitle) toastTitle.innerText = title;
        if (toastDesc) toastDesc.innerText = desc;

        if (isGold) {
          if (toastTitle) toastTitle.className = 'font-mono text-xs font-bold text-yellow-400';
          if (iconWrap) iconWrap.className = 'w-8 h-8 rounded-xl bg-yellow-400/20 border border-yellow-400/40 flex items-center justify-center text-yellow-400';
          if (toastIcon) toastIcon.innerText = customIcon || 'auto_awesome';
        } else {
