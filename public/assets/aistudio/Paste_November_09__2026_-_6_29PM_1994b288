          themeBtnCyan.className = 'flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono transition-all duration-200 text-slate-400 hover:text-white';

          if (ideContainer) ideContainer.classList.add('theme-gold');
          if (auraEl) {
            auraEl.style.background = 'radial-gradient(circle, rgba(251, 191, 36, 0.28) 0%, rgba(16, 185, 129, 0.18) 45%, transparent 80%)';
          }
          if (coreEl) {
            coreEl.style.background = '#fbbf24';
            coreEl.style.boxShadow = '0 0 14px #fbbf24, 0 0 25px #10b981';
          }
          if (nebulaBlob1) {
            nebulaBlob1.className = 'fixed top-0 left-1/4 w-[600px] h-[600px] bg-gradient-to-br from-yellow-500/15 via-emerald-600/15 to-transparent rounded-full blur-[140px] pointer-events-none -z-10 animate-[nebula-pulse_8s_ease-in-out_infinite]';
          }
          if (nebulaBlob2) {
            nebulaBlob2.className = 'fixed top-1/2 -right-28 w-[550px] h-[550px] bg-gradient-to-bl from-emerald-500/15 via-yellow-500/10 to-transparent rounded-full blur-[130px] pointer-events-none -z-10';
          }
          playGoldEmeraldSfx();
        }
      }

      if (themeBtnCyan) themeBtnCyan.addEventListener('click', () => applyTheme('cyan'));
      if (themeBtnGold) themeBtnGold.addEventListener('click', () => applyTheme('gold'));

      if (sfxToggleBtn) {
        sfxToggleBtn.addEventListener('click', () => {
          sfxEnabled = !sfxEnabled;
          if (sfxEnabled) {
            sfxIcon.innerText = 'volume_up';
            sfxIcon.className = 'material-symbols-outlined text-base text-cyan-400 group-hover:scale-110 transition-transform';
            sfxLabel.innerText = 'SFX: ON';
            sfxLabel.className = 'font-mono text-xs font-semibold text-cyan-400';
            if (sfxWaveBars) sfxWaveBars.classList.remove('opacity-25');
            playTactileClick();
            showSfxToast('Audio SFX Enabled', 'Synthesized Web Audio triggers are active', false);
          } else {
            sfxIcon.innerText = 'volume_off';
            sfxIcon.className = 'material-symbols-outlined text-base text-slate-400 group-hover:scale-110 transition-transform';
            sfxLabel.innerText = 'SFX: MUTED';
            sfxLabel.className = 'font-mono text-xs font-semibold text-slate-400';
            if (sfxWaveBars) sfxWaveBars.classList.add('opacity-25');
            showSfxToast('Audio SFX Muted', 'Sound effects temporarily muted', false);
          }
        });
      }

      // Cursor tracking & galaxy stardust canvas
      const canvas = document.getElementById('galaxy-dots-canvas');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        });

        const particles = [];
        const count = 75;
        for (let i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            radius: Math.random() * 1.8 + 0.6,
            vx: (Math.random() - 0.5) * 0.4,
            vy: (Math.random() - 0.5) * 0.4,
            alpha: Math.random() * 0.6 + 0.3
          });
        }

        let mouseX = -1000, mouseY = -1000;
        let curX = -1000, curY = -1000;

        window.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          if (auraEl) auraEl.style.opacity = '1';
          if (coreEl) coreEl.style.opacity = '1';
        });

        document.addEventListener('mouseleave', () => {
          if (auraEl) auraEl.style.opacity = '0';
          if (coreEl) coreEl.style.opacity = '0';
        });

        function render() {
          ctx.clearRect(0, 0, width, height);

          curX += (mouseX - curX) * 0.15;
          curY += (mouseY - curY) * 0.15;

          if (auraEl) {
            auraEl.style.left = `${curX}px`;
            auraEl.style.top = `${curY}px`;
          }
          if (coreEl) {
            coreEl.style.left = `${mouseX}px`;
            coreEl.style.top = `${mouseY}px`;
          }

          const isGold = (currentTheme === 'gold');
          const pColor = isGold ? 'rgba(251, 191, 36,' : 'rgba(56, 189, 248,';

          particles.forEach((p, idx) => {
            p.x += p.vx;
            p.y += p.vy;
            if (p.x < 0) p.x = width;
            if (p.x > width) p.x = 0;
            if (p.y < 0) p.y = height;
            if (p.y > height) p.y = 0;

            const dx = p.x - mouseX;
            const dy = p.y - mouseY;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 100) {
              const force = (100 - dist) / 100;
              p.x += (dx / dist) * force * 2.5;
              p.y += (dy / dist) * force * 2.5;
            }

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fillStyle = `${pColor} ${p.alpha})`;
            ctx.fill();

            for (let j = idx + 1; j < particles.length; j++) {
              const p2 = particles[j];
              const d = Math.hypot(p.x - p2.x, p.y - p2.y);
              if (d < 80) {
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
                ctx.lineTo(p2.x, p2.y);
                ctx.strokeStyle = `${pColor} ${(1 - d / 80) * 0.15})`;
                ctx.lineWidth = 0.6;
                ctx.stroke();
              }
            }
          });

          requestAnimationFrame(render);
        }
        render();
      }

      // Run code simulation with synthesized SFX
      const runBtn = document.getElementById('run-code-btn');
      const runIcon = document.getElementById('run-code-icon');
      const runLabel = document.getElementById('run-code-label');
      const stdout = document.getElementById('stdout-output');

      if (runBtn && stdout) {
        runBtn.addEventListener('click', () => {
          playRunCodeSequence();
          showSfxToast('⚡ Executing Sandbox', `Orbital Audio Synthesizer: Run Sequence (${audioState.pitchPresetName})`, false, 'terminal');

          runIcon.className = 'w-3.5 h-3.5 border-2 border-cyan-400 border-t-transparent rounded-full animate-spin';
          runLabel.innerText = 'Executing in Orbit...';
          stdout.innerHTML = '<span class="text-cyan-400">Compiling bytecode in orbital sandbox v3.12...</span>';

          setTimeout(() => {
            stdout.innerHTML = '<span class="text-emerald-400">Fibonacci(10): 55</span><div class="text-[10px] text-slate-500 mt-1">CPU Time: 0.019s · Zero recursion overflow · Top-down memo hit 100%</div>';
            runIcon.className = 'material-symbols-outlined text-sm';
            runLabel.innerText = 'Run Code';

            playRunCompletedChime();
            showSfxToast('✨ Test Cases Passed', `Crystalline Triad Chime Synthesized (${audioState.pitchPresetName})`, false, 'check_circle');
          }, 850);
        });
      }

      // Submit Solution Button with Grand Fanfare and Celebration Modal
      const submitBtn = document.getElementById('submit-solution-btn');
      const celebrationModal = document.getElementById('celebration-modal');
      const celebrationCard = document.getElementById('celebration-card');
      const closeModalBtn = document.getElementById('close-modal-btn');
      const nextProblemBtn = document.getElementById('next-problem-btn');

      function openCelebrationModal() {
        if (!celebrationModal) return;
        celebrationModal.classList.remove('opacity-0', 'pointer-events-none');
        celebrationModal.classList.add('opacity-100');
        if (celebrationCard) {
          celebrationCard.classList.remove('scale-95');
          celebrationCard.classList.add('scale-100');
        }
      }

      function closeCelebrationModal() {
        if (!celebrationModal) return;
        celebrationModal.classList.add('opacity-0', 'pointer-events-none');
        celebrationModal.classList.remove('opacity-100');
        if (celebrationCard) {
          celebrationCard.classList.add('scale-95');
          celebrationCard.classList.remove('scale-100');
        }
      }

      if (submitBtn) {
        submitBtn.addEventListener('click', () => {
          playVictoryFanfare();
          showSfxToast('🏆 Verified: 100% Score', `Celestial Fanfare: A Major 9th Ascending Triad (${audioState.pitchPresetName})`, true, 'military_tech');
          openCelebrationModal();
        });
      }

      if (closeModalBtn) closeModalBtn.addEventListener('click', closeCelebrationModal);
      if (nextProblemBtn) {
        nextProblemBtn.addEventListener('click', () => {
          playTactileClick();
          closeCelebrationModal();
          showSfxToast('Next Problem Loaded', 'P-04 Two Sum Problem ready in sandbox', false, 'code');
        });
      }
      if (celebrationModal) {
        celebrationModal.addEventListener('click', (e) => {
          if (e.target === celebrationModal) closeCelebrationModal();
        });
      }

      // Copy code feedback with tactile snap sound effect
      const copyBtn = document.getElementById('copy-code-btn');
      const copyIcon = document.getElementById('copy-btn-icon');
      const copyText = document.getElementById('copy-btn-text');
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          playTactileClick();
          copyIcon.innerText = 'check';
          copyIcon.className = 'material-symbols-outlined text-sm text-emerald-400';
          copyText.innerText = 'Copied!';
          showSfxToast('Code Copied', 'Tactile snap pop sound synthesized', false, 'content_copy');

          setTimeout(() => {
            copyIcon.innerText = 'content_copy';
            copyIcon.className = 'material-symbols-outlined text-sm';
            copyText.innerText = 'Copy Code';
          }, 1600);
        });
      }

      // Reset code button feedback with rewind sweep
      const resetBtn = document.getElementById('reset-code-btn');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          playResetRewindSweep();
          showSfxToast('Sandbox Restored', 'Reverse acoustic rewind sweep synthesized', false, 'restart_alt');
          if (stdout) {
            stdout.innerHTML = '<span class="text-slate-400">Environment reset. Ready to run...</span>';
          }
        });
      }

    })();
  </script>
</body></html>