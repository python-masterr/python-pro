  <!-- Interactive JavaScript: Web Audio Synthesizer Engine & Theme Switching -->
  <script>
    (function() {
      // ==========================================
      // WEB AUDIO SYNTHESIZER ENGINE
      // ==========================================
      let audioCtx = null;
      let sfxEnabled = true;

      function getAudioContext() {
        if (!audioCtx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) {
            audioCtx = new AudioContext();
          }
        }
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        return audioCtx;
      }

      let toastTimer = null;
      function showSfxToast(title, desc, isGold) {
        const toast = document.getElementById('sfx-toast');
        const toastTitle = document.getElementById('toast-title');
        const toastDesc = document.getElementById('toast-desc');
        const iconWrap = document.getElementById('toast-icon-wrap');
        const toastIcon = document.getElementById('toast-icon');

        if (!toast) return;
        if (toastTitle) toastTitle.innerText = title;
        if (toastDesc) toastDesc.innerText = desc;

        if (isGold) {
          if (toastTitle) toastTitle.className = 'font-mono text-xs font-bold text-yellow-400';
          if (iconWrap) iconWrap.className = 'w-8 h-8 rounded-xl bg-yellow-400/20 border border-yellow-400/40 flex items-center justify-center text-yellow-400';
          if (toastIcon) toastIcon.innerText = 'auto_awesome';
        } else {
          if (toastTitle) toastTitle.className = 'font-mono text-xs font-bold text-cyan-400';
          if (iconWrap) iconWrap.className = 'w-8 h-8 rounded-xl bg-cyan-500/20 border border-cyan-400/40 flex items-center justify-center text-cyan-400';
          if (toastIcon) toastIcon.innerText = 'music_note';
        }

        toast.classList.remove('opacity-0', 'translate-y-3');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-3');
        }, 2200);
      }

      // SFX 1: Cosmic Cyan - Crystalline high-tech chime & ascending resonant frequency sweep (528Hz triad)
      function playCosmicCyanSfx() {
        if (!sfxEnabled) return;
        const ctx = getAudioContext();
        if (!ctx) return;

        const now = ctx.currentTime;
        const masterGain = ctx.createGain();
        masterGain.gain.setValueAtTime(0.28, now);
        masterGain.gain.exponentialRampToValueAtTime(0.0001, now + 1.4);
        masterGain.connect(ctx.destination);

        const notes = [528, 792, 1056];
        notes.forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const noteGain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now + idx * 0.08);
          osc.frequency.exponentialRampToValueAtTime(freq * 1.25, now + idx * 0.08 + 0.4);

          noteGain.gain.setValueAtTime(0, now);
          noteGain.gain.setValueAtTime(0.25 / (idx + 1), now + idx * 0.08);
          noteGain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.8);

          osc.connect(noteGain);
          noteGain.connect(masterGain);
          osc.start(now + idx * 0.08);
          osc.stop(now + idx * 0.08 + 0.85);
        });

        // Pulsar shimmer noise
        const sweepOsc = ctx.createOscillator();
        const sweepGain = ctx.createGain();
        sweepOsc.type = 'triangle';
        sweepOsc.frequency.setValueAtTime(1400, now);
        sweepOsc.frequency.exponentialRampToValueAtTime(2800, now + 0.35);

        sweepGain.gain.setValueAtTime(0.08, now);
        sweepGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.5);

        sweepOsc.connect(sweepGain);
        sweepGain.connect(masterGain);
        sweepOsc.start(now);
        sweepOsc.stop(now + 0.55);

        showSfxToast('Cosmic Nebula Warp', 'Cyan / Magenta SFX Synthesized (528Hz Solfeggio Triad)', false);
      }

      // SFX 2: Gold & Emerald Alchemy - Warm resonant celestial shimmer chord (432Hz harmonic triad)
      function playGoldEmeraldSfx() {
        if (!sfxEnabled) return;
        const ctx = getAudioContext();
        if (!ctx) return;

        const now = ctx.currentTime;
        const masterGain = ctx.createGain();
        masterGain.gain.setValueAtTime(0.32, now);
        masterGain.gain.exponentialRampToValueAtTime(0.0001, now + 1.8);
        masterGain.connect(ctx.destination);

        const notes = [432, 648, 864, 1296];
        notes.forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const noteGain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + idx * 0.07);

          noteGain.gain.setValueAtTime(0, now);
          noteGain.gain.setValueAtTime(0.28 / (idx + 1), now + idx * 0.07);
          noteGain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.07 + 1.2);

          osc.connect(noteGain);
          noteGain.connect(masterGain);
          osc.start(now + idx * 0.07);
          osc.stop(now + idx * 0.07 + 1.3);
        });

        const chime = ctx.createOscillator();
        const chimeGain = ctx.createGain();
        chime.type = 'sine';
        chime.frequency.setValueAtTime(1728, now + 0.15);
        chimeGain.gain.setValueAtTime(0.12, now + 0.15);
        chimeGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.9);

        chime.connect(chimeGain);
        chimeGain.connect(masterGain);
        chime.start(now + 0.15);
        chime.stop(now + 0.95);

        showSfxToast('Celestial Alchemy Chime', 'Gold & Emerald SFX Synthesized (432Hz Natural Triad)', true);
      }

      // Tactical pop for SFX mute/unmute
      function playTactileClick() {
        const ctx = getAudioContext();
        if (!ctx) return;
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(800, now);
        osc.frequency.exponentialRampToValueAtTime(1200, now + 0.06);

        gain.gain.setValueAtTime(0.15, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.09);
      }

      // Theme Application
      let currentTheme = 'cyan';
      const themeBtnCyan = document.getElementById('theme-btn-cyan');
      const themeBtnGold = document.getElementById('theme-btn-gold');
      const sfxToggleBtn = document.getElementById('sfx-toggle-btn');
      const sfxIcon = document.getElementById('sfx-icon');
      const sfxLabel = document.getElementById('sfx-label');
      const sfxWaveBars = document.getElementById('sfx-wave-bars');
      const ideContainer = document.getElementById('ide-container');
      const auraEl = document.getElementById('cosmic-cursor-aura');
      const coreEl = document.getElementById('cosmic-cursor-core');
      const nebulaBlob1 = document.getElementById('nebula-blob-1');
      const nebulaBlob2 = document.getElementById('nebula-blob-2');

      function applyTheme(theme) {
        currentTheme = theme;
        window.activeThemeName = theme;

        if (theme === 'cyan') {
          themeBtnCyan.className = 'flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono transition-all duration-200 bg-slate-800 text-cyan-400 border border-cyan-400/40 shadow-[0_0_10px_rgba(6,182,212,0.35)]';
          themeBtnGold.className = 'flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono transition-all duration-200 text-slate-400 hover:text-white';

          if (ideContainer) ideContainer.classList.remove('theme-gold');
          if (auraEl) {
            auraEl.style.background = 'radial-gradient(circle, rgba(6, 182, 212, 0.28) 0%, rgba(217, 70, 239, 0.18) 45%, transparent 80%)';
          }
          if (coreEl) {
            coreEl.style.background = '#38bdf8';
            coreEl.style.boxShadow = '0 0 14px #38bdf8, 0 0 25px #d946ef';
          }
          if (nebulaBlob1) {
            nebulaBlob1.className = 'fixed top-0 left-1/4 w-[600px] h-[600px] bg-gradient-to-br from-cyan-500/20 via-purple-600/15 to-transparent rounded-full blur-[140px] pointer-events-none -z-10 animate-[nebula-pulse_8s_ease-in-out_infinite]';
          }
          if (nebulaBlob2) {
            nebulaBlob2.className = 'fixed top-1/2 -right-28 w-[550px] h-[550px] bg-gradient-to-bl from-fuchsia-500/15 via-pink-600/10 to-transparent rounded-full blur-[130px] pointer-events-none -z-10';
          }
          playCosmicCyanSfx();
        } else {
          themeBtnGold.className = 'flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono transition-all duration-200 bg-slate-800 text-yellow-400 border border-yellow-400/40 shadow-[0_0_10px_rgba(251,191,36,0.35)]';
          themeBtnCyan.className = 'flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono transition-all duration-200 text-slate-400 hover:text-white';

          if (ideContainer) ideContainer.classList.add('theme-gold');
          if (auraEl) {
            auraEl.style.background = 'radial-gradient(circle, rgba(251, 191, 36, 0.28) 0%, rgba(16, 185, 129, 0.18) 45%, transparent 80%)';
          }
          if (coreEl) {
            coreEl.style.background = '#fbbf24';
            coreEl.style.boxShadow = '0 0 14px #fbbf24, 0 0 25px #10b981';
          }
          if (nebulaBlob1) {
            nebulaBlob1.className = 'fixed top-0 left-1/4 w-[600px] h-[600px] bg-gradient-to-br from-yellow-500/15 via-emerald-600/15 to-transparent rounded-full blur-[140px] pointer-events-none -z-10 animate-[nebula-pulse_8s_ease-in-out_infinite]';
          }
          if (nebulaBlob2) {
            nebulaBlob2.className = 'fixed top-1/2 -right-28 w-[550px] h-[550px] bg-gradient-to-bl from-emerald-500/15 via-yellow-500/10 to-transparent rounded-full blur-[130px] pointer-events-none -z-10';
          }
          playGoldEmeraldSfx();
        }
      }

      if (themeBtnCyan) themeBtnCyan.addEventListener('click', () => applyTheme('cyan'));
      if (themeBtnGold) themeBtnGold.addEventListener('click', () => applyTheme('gold'));

      if (sfxToggleBtn) {
        sfxToggleBtn.addEventListener('click', () => {
          sfxEnabled = !sfxEnabled;
          if (sfxEnabled) {
            sfxIcon.innerText = 'volume_up';
            sfxIcon.className = 'material-symbols-outlined text-base text-cyan-400 group-hover:scale-110 transition-transform';
            sfxLabel.innerText = 'SFX: ON';
            sfxLabel.className = 'font-mono text-xs font-semibold text-cyan-400';
            if (sfxWaveBars) sfxWaveBars.classList.remove('opacity-25');
            playTactileClick();
            showSfxToast('Audio SFX Enabled', 'Synthesized Web Audio triggers are active', false);
          } else {
            sfxIcon.innerText = 'volume_off';
            sfxIcon.className = 'material-symbols-outlined text-base text-slate-400 group-hover:scale-110 transition-transform';
            sfxLabel.innerText = 'SFX: MUTED';
            sfxLabel.className = 'font-mono text-xs font-semibold text-slate-400';
            if (sfxWaveBars) sfxWaveBars.classList.add('opacity-25');
            showSfxToast('Audio SFX Muted', 'Sound effects temporarily muted', false);
          }
        });
      }

      // Cursor tracking & galaxy stardust canvas
      const canvas = document.getElementById('galaxy-dots-canvas');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        });

        const particles = [];
        const count = 75;
        for (let i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            radius: Math.random() * 1.8 + 0.6,
            vx: (Math.random() - 0.5) * 0.4,
            vy: (Math.random() - 0.5) * 0.4,
            alpha: Math.random() * 0.6 + 0.3
          });
        }

        let mouseX = -1000, mouseY = -1000;
        let curX = -1000, curY = -1000;

        window.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          if (auraEl) auraEl.style.opacity = '1';
          if (coreEl) coreEl.style.opacity = '1';
        });

        document.addEventListener('mouseleave', () => {
          if (auraEl) auraEl.style.opacity = '0';
          if (coreEl) coreEl.style.opacity = '0';
        });

        function render() {
          ctx.clearRect(0, 0, width, height);

          // Smooth lerp cursor
          curX += (mouseX - curX) * 0.15;
          curY += (mouseY - curY) * 0.15;

          if (auraEl) {
            auraEl.style.left = `${curX}px`;
            auraEl.style.top = `${curY}px`;
          }
          if (coreEl) {
            coreEl.style.left = `${mouseX}px`;
            coreEl.style.top = `${mouseY}px`;
          }

          const isGold = (currentTheme === 'gold');
          const pColor = isGold ? 'rgba(251, 191, 36,' : 'rgba(56, 189, 248,';

          particles.forEach((p, idx) => {
            p.x += p.vx;
            p.y += p.vy;
            if (p.x < 0) p.x = width;
            if (p.x > width) p.x = 0;
            if (p.y < 0) p.y = height;
            if (p.y > height) p.y = 0;

            // Repulsion from mouse
            const dx = p.x - mouseX;
            const dy = p.y - mouseY;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 100) {
              const force = (100 - dist) / 100;
              p.x += (dx / dist) * force * 2.5;
              p.y += (dy / dist) * force * 2.5;
            }

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fillStyle = `${pColor} ${p.alpha})`;
            ctx.fill();

            // Connect nearby stars
            for (let j = idx + 1; j < particles.length; j++) {
              const p2 = particles[j];
              const d = Math.hypot(p.x - p2.x, p.y - p2.y);
              if (d < 80) {
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
                ctx.lineTo(p2.x, p2.y);
                ctx.strokeStyle = `${pColor} ${(1 - d / 80) * 0.15})`;
                ctx.lineWidth = 0.6;
                ctx.stroke();
              }
            }
          });

          requestAnimationFrame(render);
        }
        render();
      }

      // Run code simulation
      const runBtn = document.getElementById('run-code-btn');
      const runIcon = document.getElementById('run-code-icon');
      const runLabel = document.getElementById('run-code-label');
      const stdout = document.getElementById('stdout-output');

